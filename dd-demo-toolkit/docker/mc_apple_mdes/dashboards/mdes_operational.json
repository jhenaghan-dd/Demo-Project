{
  "title": "MDES Apple Pay Provisioning - Operational Dashboard",
  "description": "Operational view of Apple Pay (MDES) provisioning across STL/KSC. Synthetic recreation of a Mastercard Splunk dashboard. [dd-demo-toolkit:payments]",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "site",
      "prefix": "site",
      "available_values": [
        "stl",
        "ksc"
      ],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "## MDES Apple Pay Provisioning - Operational Dashboard\nApple inbound, application, and outbound provisioning flow across the **STL** and **KSC** sites.",
        "background_color": "gray",
        "font_size": "16",
        "text_align": "left",
        "vertical_align": "center",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 2
      }
    },
    {
      "definition": {
        "title": "Apple Inbound Metrics at API Gateway - STL",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "vivid_blue",
        "widgets": [
          {
            "definition": {
              "title": "Inbound Traffic Volume - STL Gateway (by operation)",
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "q",
                      "indexes": [
                        "*"
                      ],
                      "search": {
                        "query": "service:apigw @gwdestinationtype:INBOUND @operation:REQUEST site:stl"
                      },
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [
                        {
                          "facet": "@op_name",
                          "limit": 15,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        }
                      ]
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 4
            }
          },
          {
            "definition": {
              "title": "Inbound Response Time p90 (ms) - STL Gateway",
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "q",
                      "indexes": [
                        "*"
                      ],
                      "search": {
                        "query": "service:apigw @gwdestinationtype:INBOUND @operation:RESPONSE site:stl"
                      },
                      "compute": {
                        "aggregation": "pc90",
                        "metric": "@response_time_ms"
                      },
                      "group_by": [
                        {
                          "facet": "@op_name",
                          "limit": 15,
                          "sort": {
                            "aggregation": "pc90",
                            "order": "desc",
                            "metric": "@response_time_ms"
                          }
                        }
                      ]
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 4
            }
          },
          {
            "definition": {
              "title": "HTTP Response Trend - STL Gateway (log scale)",
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "q",
                      "indexes": [
                        "*"
                      ],
                      "search": {
                        "query": "service:apigw @gwdestinationtype:INBOUND @operation:RESPONSE site:stl"
                      },
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [
                        {
                          "facet": "@gwhttpstatus",
                          "limit": 15,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        }
                      ]
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "yaxis": {
                "scale": "log",
                "include_zero": false
              }
            },
            "layout": {
              "x": 0,
              "y": 4,
              "width": 12,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 2,
        "width": 12,
        "height": 8
      }
    },
