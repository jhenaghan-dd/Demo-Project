          {
            "definition": {
              "title": "Application Exceptions - STL",
              "type": "query_table",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "c",
                      "indexes": [
                        "*"
                      ],
                      "search": {
                        "query": "service:mdes-mntbwltorc-wallet-api @msg.message:\"Request Details. FINAL_LOG_STMT\" -@msg.statuscode:200 site:stl"
                      },
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [
                        {
                          "facet": "@msg.operation",
                          "limit": 8,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        },
                        {
                          "facet": "@msg.statuscode",
                          "limit": 8,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        },
                        {
                          "facet": "@msg.networksubstatuscode",
                          "limit": 4,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        },
                        {
                          "facet": "@msg.statusmessage",
                          "limit": 4,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        },
                        {
