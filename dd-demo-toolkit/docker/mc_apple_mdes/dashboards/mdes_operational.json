    {
      "definition": {
        "title": "Application Metrics - PCF Status & Exceptions",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "gray",
        "widgets": [
          {
            "definition": {
              "title": "Mandatory PCF Apps - instances (0 = DOWN)",
              "type": "query_table",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "ksc",
                      "indexes": [
                        "*"
                      ],
                      "search": {
                        "query": "service:mdes-mntbwltorc-wallet-api @app.cf_app_name:* site:ksc"
                      },
                      "compute": {
                        "aggregation": "max",
                        "metric": "@app.instances"
                      },
                      "group_by": [
                        {
                          "facet": "@app.cf_app_name",
                          "limit": 100,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        }
                      ]
                    },
                    {
                      "data_source": "logs",
                      "name": "stl",
                      "indexes": [
                        "*"
                      ],
                      "search": {
                        "query": "service:mdes-mntbwltorc-wallet-api @app.cf_app_name:* site:stl"
                      },
                      "compute": {
                        "aggregation": "max",
                        "metric": "@app.instances"
                      },
                      "group_by": [
                        {
                          "facet": "@app.cf_app_name",
                          "limit": 100,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        }
                      ]
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "ksc",
                      "alias": "KSC"
                    },
                    {
                      "formula": "stl",
                      "alias": "STL"
                    }
                  ],
                  "sort": {
                    "count": 100,
                    "order_by": [
                      {
                        "type": "formula",
                        "index": 0,
                        "order": "desc"
                      }
                    ]
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6
            }
          },
