{
  "title": "Apple Trouble Shooting - Logs (MDES)",
  "description": "Log drill-down for Apple Pay (MDES) provisioning: pivot by conversation/correlation/SEID. Synthetic recreation of a Mastercard Splunk dashboard. [dd-demo-toolkit:payments]",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "convid",
      "prefix": "@msg.conversationId",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "corr_id",
      "prefix": "@msg.correlationid",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "seid",
      "prefix": "@msg.SEID",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "errorcode",
      "prefix": "@msg.statuscode",
      "available_values": [
        "50000",
        "50001",
        "48101",
        "48000",
        "48002"
      ],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "## Apple Trouble Shooting - Logs\nPivot on **Conversation ID** (`$convid`), **Correlation ID** (`$corr_id`), **SEID** (`$seid`), or **Error Code** (`$errorcode`) using the template variables above; every panel filters to the selected transaction.",
        "background_color": "gray",
        "font_size": "16",
        "text_align": "left",
        "vertical_align": "center",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 2
      }
    },
    {
      "definition": {
        "title": "Troubleshooting - Errors PCF (FINAL_LOG_STMT)",
        "type": "list_stream",
        "requests": [
          {
            "response_format": "event_list",
            "columns": [
              {
                "field": "timestamp",
                "width": "auto"
              },
              {
                "field": "@msg.operation",
                "width": "auto"
              },
              {
                "field": "@msg.correlationid",
                "width": "auto"
              },
              {
                "field": "@msg.conversationId",
                "width": "auto"
              },
              {
                "field": "@msg.statuscode",
                "width": "auto"
              },
              {
                "field": "@msg.mdeserrorcode",
                "width": "auto"
              },
              {
                "field": "@msg.networksubstatuscode",
                "width": "auto"
              },
              {
                "field": "@msg.statusmessage",
                "width": "auto"
              }
            ],
            "query": {
              "data_source": "logs_stream",
              "query_string": "service:mdes-mntbwltorc-wallet-api @msg.message:\"Request Details. FINAL_LOG_STMT\" -@msg.statuscode:200 $errorcode $seid $convid",
              "indexes": [],
              "storage": "hot"
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 2,
        "width": 12,
        "height": 4
      }
    },
    {
      "definition": {
        "title": "APIGW Call Trail for Correlation ID $corr_id",
        "type": "list_stream",
        "requests": [
          {
            "response_format": "event_list",
            "columns": [
              {
                "field": "timestamp",
                "width": "auto"
              },
              {
                "field": "@operation",
                "width": "auto"
              },
              {
                "field": "@endpoint",
                "width": "auto"
              },
              {
                "field": "@gwrequesturi",
                "width": "auto"
              },
              {
                "field": "@correlationid",
                "width": "auto"
              },
              {
                "field": "@gwhttpstatus",
                "width": "auto"
              },
              {
                "field": "@device_id",
                "width": "auto"
              },
              {
                "field": "site",
                "width": "auto"
              }
            ],
            "query": {
              "data_source": "logs_stream",
              "query_string": "service:apigw $corr_id",
              "indexes": [],
              "storage": "hot"
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 12,
        "height": 4
      }
    },
    {
      "definition": {
        "title": "APIGW Call Trail for Conversation ID $convid",
        "type": "list_stream",
        "requests": [
          {
            "response_format": "event_list",
            "columns": [
              {
                "field": "timestamp",
                "width": "auto"
              },
              {
                "field": "@operation",
                "width": "auto"
              },
              {
                "field": "@endpoint",
                "width": "auto"
              },
              {
                "field": "@gwrequesturi",
                "width": "auto"
              },
              {
                "field": "@correlationid",
                "width": "auto"
              },
              {
                "field": "@device_id",
                "width": "auto"
              },
              {
                "field": "@gwhttpstatus",
                "width": "auto"
              },
              {
                "field": "site",
                "width": "auto"
              }
            ],
            "query": {
              "data_source": "logs_stream",
              "query_string": "service:apigw $convid",
              "indexes": [],
              "storage": "hot"
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 10,
        "width": 12,
        "height": 4
      }
    },
    {
      "definition": {
        "title": "EPT Web logs for $convid",
        "type": "list_stream",
        "requests": [
          {
            "response_format": "event_list",
            "columns": [
              {
                "field": "timestamp",
                "width": "auto"
              },
              {
                "field": "host",
                "width": "auto"
              },
              {
                "field": "@conversationid",
                "width": "auto"
              },
              {
                "field": "@device_id",
                "width": "auto"
              },
              {
                "field": "message",
                "width": "auto"
              }
            ],
            "query": {
              "data_source": "logs_stream",
              "query_string": "service:ept-web source:outbound $convid",
              "indexes": [],
              "storage": "hot"
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 14,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "title": "PCF Error events for $convid",
        "type": "list_stream",
        "requests": [
          {
            "response_format": "event_list",
            "columns": [
              {
                "field": "timestamp",
                "width": "auto"
              },
              {
                "field": "@msg.operation",
                "width": "auto"
              },
              {
                "field": "@msg.message",
                "width": "auto"
              },
              {
                "field": "@msg.xception",
                "width": "auto"
              },
              {
                "field": "@msg.level",
                "width": "auto"
              }
            ],
            "query": {
              "data_source": "logs_stream",
              "query_string": "service:mdes-mntbwltorc-wallet-api status:error $convid",
              "indexes": [],
              "storage": "hot"
            }
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 14,
        "width": 6,
        "height": 4
      }
    },
    {
      "definition": {
        "title": "Token Resolution (TUR_01) for $convid",
        "type": "list_stream",
        "requests": [
          {
            "response_format": "event_list",
            "columns": [
              {
                "field": "timestamp",
                "width": "auto"
              },
              {
                "field": "@msg.TUR_01",
                "width": "auto"
              },
              {
                "field": "@msg.srcTokenUniqueReference",
                "width": "auto"
              },
              {
                "field": "@msg.TokenResolutionSource",
                "width": "auto"
              },
              {
                "field": "@msg.bin",
                "width": "auto"
              },
              {
                "field": "@msg.systemUniqueId",
                "width": "auto"
              }
            ],
            "query": {
              "data_source": "logs_stream",
              "query_string": "service:mdes-mntbwltorc-wallet-api @msg.TUR_01:* $convid",
              "indexes": [],
              "storage": "hot"
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 18,
        "width": 12,
        "height": 4
      }
    }
  ],
  "reflow_type": "fixed"
}