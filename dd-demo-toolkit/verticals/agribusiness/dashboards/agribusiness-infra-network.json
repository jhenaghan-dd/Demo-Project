{
  "title": "Bunge \u2014 Infrastructure, Network & SAP [dd-demo-toolkit:agribusiness]",
  "description": "The infra/network/database estate under evaluation: on-prem VMware compute, the 185-site / 500+ link network (SolarWinds replacement / NDM), Oracle Database Monitoring, and the SAP landscape (HANA + S/4HANA NetWeaver). SAP views show only signals Datadog actually collects. [dd-demo-toolkit:agribusiness]",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "# Bunge \u2014 Infrastructure, Network & SAP\n\nThe **2,000+ server** VMware estate, the **185-site / 500+ link** network, and the **SAP landscape** \u2014 on one platform, correlated with the apps they serve.",
        "background_color": "vivid_blue",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "VMware Host CPU & Memory by Region (avg %)",
        "show_legend": true,
        "requests": [
          {
            "formulas": [
              {
                "formula": "cpu",
                "alias": "CPU %"
              },
              {
                "formula": "mem",
                "alias": "Mem %"
              }
            ],
            "queries": [
              {
                "data_source": "metrics",
                "name": "cpu",
                "query": "avg:agri.host.cpu_pct{$environment,$region,$business_segment} by {region}"
              },
              {
                "data_source": "metrics",
                "name": "mem",
                "query": "avg:agri.host.mem_pct{$environment,$region,$business_segment} by {region}"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ]
      },
